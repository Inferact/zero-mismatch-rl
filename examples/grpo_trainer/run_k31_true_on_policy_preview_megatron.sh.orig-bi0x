#!/usr/bin/env bash
# K31 true-on-policy LoRA GRPO preview for VERL (Megatron Lite actor, batch-invariant vLLM rollout).
# The actor is the MLite K31 "vllm" implementation: its forward calls the rollout's own kernels, so
# with VLLM_BATCH_INVARIANT=1 the trainer's log-probs equal the rollout's bit for bit.  Only the LoRA
# adapter is trained; it is synced to the resident rollout with add_lora after every update, on top of
# the base checkpoint the rollout loads itself.  Router replay (R3) is off: the actor's native top-k is the
# rollout's.
# --bi 0 is the batch-variant arm (same image, same recipe): the rollout runs vLLM's default kernels with
# VLLM_BATCH_INVARIANT=0, the trainer keeps its own kernels, so its log-probs differ from the rollout's;
# old_log_prob is recomputed by the actor and the rollout/trainer mismatch is corrected with token TIS; R3 is on
# (the actor's top-k can flip against the rollout's).
# Modes: quick_alignment_test (one node x4, truncated proxy checkpoint, two updates + a third
#        rollout/actor pass that probes the second sync), aligned (full model).
# Images build on `Dockerfile.k31_true_on_policy_preview`, which sets VERL_ROOT and MEGATRON_ROOT.
# Sources:
#   VERL_ROOT: verl-project/verl main checkout
#   MEGATRON_ROOT: Megatron-LM checkout with experimental/lite (examples/verl there is verl_mlite).
#     mLite itself (megatron.lite) is the installed experimental/lite package: its K31 CUDA kernel is built
#     at install time, so the source tree is not put on PYTHONPATH.
set -euo pipefail

# Required env: RAY_ADDRESS, VERL_ROOT, MEGATRON_ROOT, MODEL_PATH, TRAIN_FILES, VAL_FILES, LORA_ADAPTER_PATH.
# RAY_ADDRESS is the Ray cluster the launch runs on, a single node included (ray start --head from the image's
# environment): the package probe checks every GPU node of it before the launch.
# LORA_ADAPTER_PATH is the theta0 adapter (peft directory, r=32, expert LoRA included); the actor
# loads it and the first sync hands it to the rollout.
SEED="${SEED:-42}"
ACTOR_LR="${ACTOR_LR:-1e-6}"
LORA_RANK="${LORA_RANK:-32}"
LORA_ALPHA="${LORA_ALPHA:-64}"
MAX_PROMPT_LENGTH="${MAX_PROMPT_LENGTH:-3072}"
PROJECT_NAME="${PROJECT_NAME:-verl-k31-preview}"

usage() {
  echo "usage: $0 --mode {quick_alignment_test|aligned} [--bi {1|0}] [Hydra overrides...]"
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 64
}

MODE="${MODE:-}"
BATCH_INVARIANT=1
HYDRA_OVERRIDES=()
while (( $# > 0 )); do
  case "$1" in
    --mode)
      [[ $# -ge 2 ]] || die "--mode requires a value"
      MODE="$2"
      shift 2
      ;;
    --bi)
      [[ $# -ge 2 ]] || die "--bi requires a value"
      BATCH_INVARIANT="$2"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      HYDRA_OVERRIDES+=("$@")
      break
      ;;
    *)
      HYDRA_OVERRIDES+=("$1")
      shift
      ;;
  esac
done
[[ -n "${MODE}" ]] || die "set --mode quick_alignment_test or aligned"
[[ "${BATCH_INVARIANT}" == 1 || "${BATCH_INVARIANT}" == 0 ]] || die "--bi takes 1 or 0, got '${BATCH_INVARIANT}'"

# --- Required repositories and inputs ---
: "${VERL_ROOT:?set VERL_ROOT to the verl checkout}"
: "${MEGATRON_ROOT:?set MEGATRON_ROOT to the Megatron-LM checkout with experimental/lite}"
: "${MODEL_PATH:?set MODEL_PATH to a K31 checkpoint (or truncated proxy) directory}"
: "${TRAIN_FILES:?set TRAIN_FILES to DAPO-format training parquet}"
: "${VAL_FILES:?set VAL_FILES to DAPO-format validation parquet}"
: "${LORA_ADAPTER_PATH:?set LORA_ADAPTER_PATH to the theta0 peft adapter directory}"
# A launch (not DRY_RUN / COMPOSE_ONLY) runs on the Ray cluster at RAY_ADDRESS, whose nodes the package probe checks;
# Ray's `local` would start a private cluster for the probe and another one for the trainer, so it is refused.
[[ "${DRY_RUN:-0}" == 1 || "${COMPOSE_ONLY:-0}" == 1 || ( -n "${RAY_ADDRESS:-}" && "${RAY_ADDRESS}" != local ) ]] \
  || die "set RAY_ADDRESS to the Ray cluster this launch runs on, a single node included (ray start --head from the image's environment)"
MLITE_EXAMPLE_ROOT="${MEGATRON_ROOT}/experimental/lite/examples/verl"
[[ -s "${MODEL_PATH}/config.json" ]] || die "missing ${MODEL_PATH}/config.json"
[[ -s "${LORA_ADAPTER_PATH}/adapter_config.json" ]] || die "missing ${LORA_ADAPTER_PATH}/adapter_config.json"
# Data files: comma-separated paths, passed to Hydra as a list.
IFS=, read -r -a TRAIN_FILE_LIST <<<"${TRAIN_FILES}"
IFS=, read -r -a VAL_FILE_LIST <<<"${VAL_FILES}"
(( ${#TRAIN_FILE_LIST[@]} && ${#VAL_FILE_LIST[@]} )) || die "TRAIN_FILES and VAL_FILES need at least one file"
for file in "${TRAIN_FILE_LIST[@]}" "${VAL_FILE_LIST[@]}"; do
  [[ -n "${file}" ]] || die "empty entry in TRAIN_FILES or VAL_FILES"
  [[ "${DRY_RUN:-0}" == 1 || -f "${file}" ]] || die "missing data file: ${file}"
done

# --- Mode presets ---
case "${MODE}" in
  quick_alignment_test)
    : "${TOTAL_TRAINING_STEPS:=3}"
    : "${TRAIN_BATCH_SIZE:=4}"
    : "${PPO_MINI_BATCH_SIZE:=4}"
    : "${ROLLOUT_N:=4}"
    : "${MAX_RESPONSE_LENGTH:=512}"
    : "${ROLLOUT_GPU_MEMORY_UTILIZATION:=0.90}"
    : "${NNODES:=1}"
    : "${NGPUS_PER_NODE:=4}"
    : "${SAVE_FREQ:=-1}"
    : "${TEST_FREQ:=-1}"
    ;;
  aligned)
    : "${TOTAL_TRAINING_STEPS:=100}"
    : "${TRAIN_BATCH_SIZE:=128}"
    : "${PPO_MINI_BATCH_SIZE:=32}"
    : "${ROLLOUT_N:=8}"
    : "${MAX_RESPONSE_LENGTH:=2048}"
    : "${ROLLOUT_GPU_MEMORY_UTILIZATION:=0.90}"
    : "${NNODES:=4}"
    : "${NGPUS_PER_NODE:=4}"
    : "${SAVE_FREQ:=5}"
    : "${TEST_FREQ:=10}"
    ;;
  *)
    die "unknown mode '${MODE}'"
    ;;
esac

WORLD_SIZE=$((NNODES * NGPUS_PER_NODE))
# Attention TP=1 with DP x EP everywhere: the K31 batch-invariant reductions are EP trees, and the
# trainer's log-probs are identical for any EP (checked for actor EP1/4/16 vs rollout EP4).  The default is
# one rollout replica per node (DP x EP = GPUs per node); ROLLOUT_DP = ROLLOUT_EP = k x GPUs per node
# runs one replica over k nodes (the head serves it, the other nodes run headless engines), which a
# model too large for one node's EP needs.
# Actor pipeline stages (the full model needs PP, e.g. PP4 x EP16 on 16 nodes); each stage
# holds WORLD_SIZE / ACTOR_PP ranks, which form its EP group by default.
: "${ACTOR_PP:=1}"
(( WORLD_SIZE % ACTOR_PP == 0 )) || die "ACTOR_PP=${ACTOR_PP} must divide ${WORLD_SIZE} GPUs"
: "${ACTOR_EP:=$((WORLD_SIZE / ACTOR_PP))}"
# Trainer activation recompute: none (empty) or full; other spellings would reach impl_cfg unchecked.
[[ -z "${ACTOR_RECOMPUTE:-}" || "${ACTOR_RECOMPUTE}" == full || "${ACTOR_RECOMPUTE}" == none ]] \
  || die "ACTOR_RECOMPUTE takes full or none, got ${ACTOR_RECOMPUTE}"
: "${ROLLOUT_DP:=${NGPUS_PER_NODE}}"
: "${ROLLOUT_EP:=${NGPUS_PER_NODE}}"
# Attention TP of each rollout replica.  TP > 1 runs the tp-ordered reductions (row-parallel sums in the TP = 1
# block order, DSA heads in their TP = 1 32-head groups), which reproduce TP = 1 bit for bit, so the trainer
# (TP 1) is unchanged; with DP 1 the replica EP = TP, and a TP 8 replica spans two 4-GPU nodes.
: "${ROLLOUT_TP:=1}"
# Router replay (R3): 1 = the rollout returns its routed experts and the actor replays them; 0 = off.
# --bi 1 defaults to 0: the actor forward is the rollout's own kernels, so its native top-k equals the rollout's,
# and replaying the rollout's routes would mask a routing flip (K31_R3=1 stays available for debugging).
# --bi 0 defaults to 1 and needs it: the actor's router logits differ from the rollout's, so its top-k can flip.
# Prefix caching is on in both arms (the GRPO samples of a prompt share it); R3 requires it (aux output connector).
if [[ "${BATCH_INVARIANT}" == 1 ]]; then
  : "${K31_R3:=0}"
else
  : "${K31_R3:=1}"
fi
[[ "${K31_R3}" == 1 || "${K31_R3}" == 0 ]] || die "K31_R3 takes 1 or 0, got '${K31_R3}'"
: "${ROLLOUT_PREFIX_CACHING:=True}"
[[ "${ROLLOUT_PREFIX_CACHING}" == True || "${ROLLOUT_PREFIX_CACHING}" == False ]] \
  || die "ROLLOUT_PREFIX_CACHING takes True or False, got '${ROLLOUT_PREFIX_CACHING}'"
if [[ "${K31_R3}" == 1 ]]; then
  ROUTER_REPLAY_MODE=R3 ROLLOUT_ROUTING_REPLAY=True
  [[ "${ROLLOUT_PREFIX_CACHING}" == True ]] || die "K31_R3=1 needs ROLLOUT_PREFIX_CACHING=True"
  [[ "${BATCH_INVARIANT}" == 0 ]] \
    || echo "note: K31_R3=1 under --bi 1 is for debugging: R3 is not needed there and would mask routing flips" >&2
else
  ROUTER_REPLAY_MODE=disabled ROLLOUT_ROUTING_REPLAY=False
fi
# K31_BYPASS=1 (default, both arms): bypass mode, old_log_prob = the rollout's log-prob (no recomputation),
# with the PPO clipped ratio against the rollout policy.  Under VLLM_BATCH_INVARIANT=1 the actor's log-probs at
# theta_old equal the rollout's bit for bit; at --bi 0 the clipped ratio is the correction of the rollout/actor
# mismatch.  Only the ppo_clip / vanilla loss with no rollout IS or RS (bypass mode applies those in the trainer
# process only; the workers would silently run vanilla).  K31_BYPASS=0 recomputes old_log_prob (--bi 0 then adds
# token TIS).  The recipe sets these values itself and, before anything runs, checks them in the configuration
# Hydra composes from all arguments (check_composed_config below), so no override form (++key=, ~key, a parent
# dict) can change them unnoticed.
: "${K31_BYPASS:=1}"
[[ "${K31_BYPASS}" == 1 || "${K31_BYPASS}" == 0 ]] || die "K31_BYPASS takes 1 or 0, got '${K31_BYPASS}'"
BYPASS_ARGS=()
if [[ "${K31_BYPASS}" == 1 ]]; then
  BYPASS_ARGS=(
    algorithm.rollout_correction.bypass_mode=True
    algorithm.rollout_correction.loss_type=ppo_clip
    algorithm.rollout_correction.rollout_is=null
    algorithm.rollout_correction.rollout_rs=null
    actor_rollout_ref.actor.policy_loss.loss_mode=vanilla
    actor_rollout_ref.actor.ppo_epochs=1
  )
fi
: "${ROLLOUT_AGENT_WORKERS:=${WORLD_SIZE}}"
# The rollout's --max-model-len is part of the DSA numerical contract (FlashMLA cache_seqlens,
# indexer chunk limits): the actor receives the same value.
MAX_MODEL_LEN=$((MAX_PROMPT_LENGTH + MAX_RESPONSE_LENGTH))
: "${ROLLOUT_MAX_MODEL_LEN:=${MAX_MODEL_LEN}}"
(( ROLLOUT_MAX_MODEL_LEN >= MAX_MODEL_LEN )) || die "ROLLOUT_MAX_MODEL_LEN < prompt + response"
: "${PPO_MAX_TOKEN_LEN_PER_GPU:=$((2 * ROLLOUT_MAX_MODEL_LEN))}"
NUM_LAYERS="$(python3 -I -c 'import json,sys;c=json.load(open(sys.argv[1]));print((c.get("text_config") or c)["num_hidden_layers"])' "${MODEL_PATH}/config.json")"
SELECTED_LAYERS="[$(seq -s, 0 $((NUM_LAYERS - 1)))]"
# Reward: VERL's rule scorer after the K31 end markers are stripped from the end of the response
# (k31_reward.py: they are not special tokens, and left in place they make "Answer: 540" wrong).
: "${REWARD_FN_PATH:=${VERL_ROOT}/examples/grpo_trainer/k31_reward.py}"
: "${REWARD_FN_NAME:=compute_score}"
LORA_TARGETS='[q_proj,k_proj,v_proj,g_proj,f_a_proj,b_proj,f_b_proj,o_proj,q_a_proj,kv_a_proj_with_mqa,q_b_proj,gate_proj,up_proj,down_proj,experts]'

if [[ -n "${TRAINER_LOGGERS:-}" ]]; then
  :
elif [[ "${WANDB_MODE:-}" == disabled ]]; then
  TRAINER_LOGGERS='[console,file]'
elif [[ -v WANDB_API_KEY || -v WANDB_ENTITY || -v WANDB_MODE ]]; then
  TRAINER_LOGGERS='[console,file,wandb]'
else
  TRAINER_LOGGERS='[console,file]'
fi

# --- Batch-invariant execution contract (rollout and actor, same values); --bi 0: vLLM's defaults ---
# --bi 1 runs the shared experts on the main stream (the tp-ordered transport needs one stream); --bi 0 leaves
# vLLM's default (shared experts on their own stream).
if [[ "${BATCH_INVARIANT}" == 1 ]]; then
  export VLLM_BATCH_INVARIANT=1 VLLM_DISABLE_SHARED_EXPERTS_STREAM=1
  export CUBLAS_WORKSPACE_CONFIG=:16:8 CUBLASLT_WORKSPACE_SIZE=1
else
  export VLLM_BATCH_INVARIANT=0
  unset VLLM_DISABLE_SHARED_EXPERTS_STREAM CUBLAS_WORKSPACE_CONFIG CUBLASLT_WORKSPACE_SIZE
fi
CUDAGRAPH_MODE=FULL_AND_PIECEWISE
export NCCL_MNNVL_ENABLE="${NCCL_MNNVL_ENABLE:-1}" NCCL_CUMEM_ENABLE="${NCCL_CUMEM_ENABLE:-1}"
export NCCL_NVLS_ENABLE="${NCCL_NVLS_ENABLE:-1}"
export PYTHONHASHSEED="${SEED}"
export PYTHONUNBUFFERED=1
# Only the recipe's own entries: an inherited PYTHONPATH would reach the Ray workers ahead of the image's packages.
export PYTHONPATH="${VERL_ROOT}:${MEGATRON_ROOT}:${MLITE_EXAMPLE_ROOT}"
# Preflight: vllm (the image's +k31 build) and megatron.lite (with its built K31 kernel) are files their installed
# distributions recorded, in one of this interpreter's site directories.  The K31 actor imports megatron.core only
# for pipeline parallelism (ACTOR_PP > 1); the image installs it from mLite's own Megatron-LM tree, in the same
# megatron directory as megatron.lite, and this checks it is that one.
[[ "${DRY_RUN:-0}" == 1 ]] || ACTOR_PP="${ACTOR_PP}" python3 - <<'PY' \
  || die "vllm / megatron.lite are not the image's packages (pip install the experimental/lite wheel; see docker/Dockerfile.k31_true_on_policy_preview)"
import importlib.metadata
import os
import site
import sys
import sysconfig

import megatron.lite
import megatron.lite.primitive.kernels._k31_mxfp4_dequant as kernel
import vllm

paths = sysconfig.get_paths()
roots = [*site.getsitepackages(), paths["purelib"], paths["platlib"]]
if site.ENABLE_USER_SITE:
    roots.append(site.getusersitepackages())
roots = {os.path.realpath(root) for root in roots}


def recorded(dist):
    # every installed distribution of that name (a venv may carry a file-less version shim of it)
    return {
        os.path.realpath(found.locate_file(f))
        for found in importlib.metadata.distributions()
        if (found.metadata["Name"] or "").lower().replace("_", "-") == dist
        for f in found.files or ()
    }


bad = []
for name, module, dist, wheel in (
    ("vllm", vllm, "vllm", "the image's vllm"),
    ("megatron.lite", megatron.lite, "nemotron-megatron-lite", "the installed experimental/lite wheel"),
    ("its K31 kernel", kernel, "nemotron-megatron-lite", "the installed experimental/lite wheel"),
):
    path = os.path.realpath(module.__file__)
    if path not in recorded(dist) or not any(path.startswith(root + os.sep) for root in roots):
        bad.append(f"{name} is {path}, not {wheel} ({dist} in {sorted(roots)})")
if not vllm.__version__.endswith("+k31"):
    bad.append(f"vllm is {vllm.__version__}, not the image's +k31 build")
try:
    import megatron.core as mcore
except ImportError:
    mcore = None
lite_dir = os.path.dirname(os.path.dirname(os.path.realpath(megatron.lite.__file__)))
if mcore is None:
    if int(os.environ["ACTOR_PP"]) > 1:
        bad.append(f"ACTOR_PP={os.environ['ACTOR_PP']} needs megatron.core, which is not installed")
elif os.path.dirname(os.path.dirname(os.path.realpath(mcore.__file__))) != lite_dir:
    bad.append(f"megatron.core is {mcore.__file__}, not the image's next to megatron.lite in {lite_dir}")
for item in bad:
    print(f"error: {item}", file=sys.stderr)
sys.exit(1 if bad else 0)
PY

runtime_config_root="$(mktemp -d /tmp/k31-preview-config.XXXXXX)"
trap 'rm -rf "${runtime_config_root}"' EXIT
mkdir -p "${runtime_config_root}/critic" "${runtime_config_root}/model_engine"
printf '%s\n' \
  '# @package _global_' \
  'model_engine: mlite' \
  >"${runtime_config_root}/model_engine/mlite.yaml"
printf '%s\n' \
  '_target_: verl.workers.config.CriticConfig' \
  'enable: false' \
  'strategy: mlite' \
  >"${runtime_config_root}/critic/mlite_critic.yaml"

OUTPUT_ROOT="${OUTPUT_ROOT:-/workspace/outputs/k31_true_on_policy_preview/${MODE}}"
RUN_NAME="${RUN_NAME:-k31_${MODE}}"
CKPT_DIR="${CKPT_DIR:-${OUTPUT_ROOT}/checkpoints/${RUN_NAME}}"
LOG_FILE="${LOG_FILE:-${OUTPUT_ROOT}/${RUN_NAME}.log}"
JSONL_FILE="${JSONL_FILE:-${OUTPUT_ROOT}/${RUN_NAME}.jsonl}"
mkdir -p "${OUTPUT_ROOT}" "${CKPT_DIR}" "$(dirname "${LOG_FILE}")" "$(dirname "${JSONL_FILE}")"
export VERL_FILE_LOGGER_PATH="${JSONL_FILE}"
# Keep the TaskRunner (dataloader state data.pt, checkpoint tracker) on this node, so a resume from a
# node-local CKPT_DIR finds them (the trainer ranks' shards stay on their own nodes).
export VERL_TASK_RUNNER_ON_DRIVER_NODE="${VERL_TASK_RUNNER_ON_DRIVER_NODE:-1}"

# Hydra arguments built from values: each value becomes a quoted Hydra string that parses back to it.
cat >"${runtime_config_root}/hydra_args.py" <<'PY'
import json
import os
import re
import sys

CREDENTIAL = re.compile(r"(^|_)(API_KEY|KEY|TOKEN|SECRET|PASSWORD|PASSWD|CREDENTIALS?)$")
# The batch-invariant execution contract the launcher sets for each --bi arm.
CONTRACT = (
    "VLLM_BATCH_INVARIANT",
    "VLLM_DISABLE_SHARED_EXPERTS_STREAM",
    "CUBLAS_WORKSPACE_CONFIG",
    "CUBLASLT_WORKSPACE_SIZE",
    "PYTHONPATH",
)
# runtime_env fields that put other code in front of the image's on the workers
CODE_KEYS = (
    "py_modules",
    "working_dir",
    "pip",
    "uv",
    "conda",
    "container",
    "image_uri",
    "py_executable",
    "worker_process_setup_hook",
)


def quoted(value):
    value = re.sub(r"(\\*)'", lambda m: "\\" * (2 * len(m.group(1))) + "\\'", value)
    value = re.sub(r"(\\+)$", lambda m: m.group(1) * 2, value)
    return "'" + value + "'"


def ray_env(job_config, names):
    """Ray runtime_env overrides on stdout; credentials into the Ray job config file instead.

    Variables the job config already sets (a Ray Jobs launch) reach the workers through it; Ray refuses a
    ray.init runtime_env that sets them again, so they are not forwarded.  The job config's value of an
    execution-contract variable must equal this launch's, or the workers would run the other arm."""
    current = os.environ.get("RAY_JOB_CONFIG_JSON_ENV_VAR")
    config = json.loads(current) if current else {}
    code = [key for key in CODE_KEYS if (config.get("runtime_env") or {}).get(key)]
    if code:
        sys.exit(f"error: the Ray job config's runtime_env sets {', '.join(code)}: the workers run the image's code")
    inherited = (config.get("runtime_env") or {}).get("env_vars") or {}
    conflicts = [
        f"the Ray job config sets {name}={str(inherited[name])!r} for the workers, this launch has "
        + (f"{name}={os.environ[name]!r}" if name in os.environ else f"{name} unset")
        for name in CONTRACT
        if name in inherited and str(inherited[name]) != os.environ.get(name)
    ]
    if conflicts:
        sys.exit("\n".join(f"error: {item}" for item in conflicts))
    job_env = {}
    for name in names:
        value = os.environ.get(name)
        if value is None or name in inherited:
            continue
        if CREDENTIAL.search(name):
            job_env[name] = value
            continue
        if "${" in value:
            sys.exit(f"error: cannot forward {name} to the Ray workers: Hydra and Ray expand '${{' in values")
        sys.stdout.write(f"+ray_kwargs.ray_init.runtime_env.env_vars.{name}={quoted(value)}\0")
    if not job_env:
        return
    if not config.get("runtime_env"):
        config["runtime_env"] = {}
    if not config["runtime_env"].get("env_vars"):
        config["runtime_env"]["env_vars"] = {}
    config["runtime_env"]["env_vars"].update(job_env)
    with os.fdopen(os.open(job_config, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump(config, f)
    with open(job_config + ".names", "w", encoding="utf-8") as f:
        f.write("\n".join(sorted(job_env)) + "\n")


if sys.argv[1] == "env":
    ray_env(sys.argv[2], sys.argv[3:])
elif sys.argv[1] == "contract":
    print(json.dumps({f"ray_kwargs.ray_init.runtime_env.env_vars.{name}": os.environ.get(name) for name in CONTRACT}))
else:
    print("[" + ",".join(quoted(item) for item in sys.argv[2:]) + "]")
PY

# Exporting in this launcher is not enough for an existing Ray cluster: forward the contract above, every
# K31_* / K3_* / K31L2_* / MLITE_* / VERL_* switch, the NCCL / GLOO / W&B settings, the library path and the
# JIT cache directories of this environment to the Ray workers, plus the names listed in K31_RAY_FORWARD_ENV
# (comma or space separated).  Values that differ per node stay with each node (K31_SLEEP_DISK_MAX_GIB: each
# node's own disk cap).  Credentials (*_API_KEY, *_TOKEN, ...) are not Hydra arguments: they reach the workers
# through Ray's job config (RAY_JOB_CONFIG_JSON_ENV_VAR, merged with one already set), so neither this launcher
# nor the trainer's printout of its configuration shows them.
RAY_ENV_PREFIXES='^(K31_|K3_|K31L2_|MLITE_|VERL_|NCCL_|GLOO_|CUDA_CACHE_|WANDB_)'
RAY_ENV_NODE_LOCAL='^(K31_SLEEP_DISK_MAX_GIB)$'
mapfile -t RAY_ENV_NAMES < <(
  {
    printf '%s\n' PATH PYTHONPATH PYTHONHASHSEED PYTHONUNBUFFERED LD_LIBRARY_PATH VLLM_BATCH_INVARIANT \
      VLLM_DISABLE_SHARED_EXPERTS_STREAM CUBLAS_WORKSPACE_CONFIG CUBLASLT_WORKSPACE_SIZE TRITON_CACHE_DIR \
      TORCHINDUCTOR_CACHE_DIR TORCH_EXTENSIONS_DIR CUTE_DSL_CACHE_DIR TILELANG_CACHE_DIR HF_HUB_OFFLINE \
      MIMALLOC_PURGE_DELAY
    tr ', ' '\n\n' <<<"${K31_RAY_FORWARD_ENV:-}"
    compgen -e | grep -E "${RAY_ENV_PREFIXES}" || true
  } | grep -E '^[A-Za-z_][A-Za-z0-9_]*$' | grep -vE "${RAY_ENV_NODE_LOCAL}" | sort -u
)
RAY_JOB_CONFIG="${runtime_config_root}/ray_job_config.json"
python3 -I "${runtime_config_root}/hydra_args.py" env "${RAY_JOB_CONFIG}" "${RAY_ENV_NAMES[@]}" \
  >"${runtime_config_root}/ray_env.args" || exit 64
mapfile -d '' -t RAY_RUNTIME_ENV <"${runtime_config_root}/ray_env.args"
RAY_JOB_ENV_NAMES=()
if [[ -s "${RAY_JOB_CONFIG}" ]]; then
  RAY_JOB_CONFIG_JSON_ENV_VAR="$(<"${RAY_JOB_CONFIG}")"
  export RAY_JOB_CONFIG_JSON_ENV_VAR
  mapfile -t RAY_JOB_ENV_NAMES <"${RAY_JOB_CONFIG}.names"
fi

TRAIN_FILES_ARG="$(python3 -I "${runtime_config_root}/hydra_args.py" list "${TRAIN_FILE_LIST[@]}")"
VAL_FILES_ARG="$(python3 -I "${runtime_config_root}/hydra_args.py" list "${VAL_FILE_LIST[@]}")"

VLLM_KW=actor_rollout_ref.rollout.engine_kwargs.vllm
IMPL=actor_rollout_ref.actor.engine.impl_cfg
HYDRA_ARGS=(
  "hydra.searchpath=[file://${runtime_config_root},pkg://verl_mlite.config]"
  model_engine=mlite

  # Algorithm and data.
  algorithm.adv_estimator=grpo
  algorithm.kl_ctrl.kl_coef=0.0
  algorithm.norm_adv_by_std_in_grpo=False
  data.train_files="${TRAIN_FILES_ARG}"
  data.val_files="${VAL_FILES_ARG}"
  data.train_batch_size="${TRAIN_BATCH_SIZE}"
  data.seed="${SEED}"
  data.shuffle=False
  data.max_prompt_length="${MAX_PROMPT_LENGTH}"
  data.max_response_length="${MAX_RESPONSE_LENGTH}"
  data.filter_overlong_prompts=True
  # In-process loading: forked loader workers get SIGKILLed during Ray teardown and the
  # TaskRunner exits with "DataLoader worker ... killed" (exit code still 0).
  data.dataloader_num_workers=0

  # Model: LoRA adapter training (base frozen, rollout loads the base checkpoint itself).
  actor_rollout_ref.model.path="${MODEL_PATH}"
  actor_rollout_ref.model.trust_remote_code=True
  actor_rollout_ref.model.lora.rank="${LORA_RANK}"
  actor_rollout_ref.model.lora.alpha="${LORA_ALPHA}"

  # Actor: MLite K31 vLLM-kernel implementation.
  actor_rollout_ref.actor.engine.impl=vllm
  actor_rollout_ref.actor.engine.model_name=k31
  actor_rollout_ref.actor.engine.tp=1
  actor_rollout_ref.actor.engine.pp="${ACTOR_PP}"
  actor_rollout_ref.actor.engine.cp=1
  actor_rollout_ref.actor.engine.ep="${ACTOR_EP}"
  actor_rollout_ref.actor.engine.etp=1
  actor_rollout_ref.actor.engine.attention_backend_override=null
  actor_rollout_ref.actor.engine.router_replay_mode="${ROUTER_REPLAY_MODE}"
  actor_rollout_ref.actor.engine.param_offload="${PARAM_OFFLOAD:-False}"
  actor_rollout_ref.actor.engine.optimizer_offload="${OPTIMIZER_OFFLOAD:-False}"
  # Offload keeps one host copy per tensor (the frozen base is copied once); node-local checkpoints
  # hold only the LoRA adapter (the base is reloaded from MODEL_PATH).
  actor_rollout_ref.actor.engine.offload_persist=True
  actor_rollout_ref.actor.engine.ckpt_trainable_only=True
  '~actor_rollout_ref.actor.engine.grad_offload'
  "${IMPL}.use_thd=False"
  "${IMPL}.qat=null"
  "+${IMPL}.use_deepep=True"
  "+${IMPL}.optimizer=adamw"
  "+${IMPL}.lora={rank:${LORA_RANK},alpha:${LORA_ALPHA},target_modules:${LORA_TARGETS}}"
  "+${IMPL}.max_lora_rank=${LORA_RANK}"
  "+${IMPL}.lora_adapter_path=${LORA_ADAPTER_PATH}"
  "+${IMPL}.rollout_max_model_len=${ROLLOUT_MAX_MODEL_LEN}"
  "+${IMPL}.max_tokens_per_rank=${PPO_MAX_TOKEN_LEN_PER_GPU}"
  "+${IMPL}.selector={global_layer_ids:${SELECTED_LAYERS},module_names:[attn,moe]}"
  # Activation recompute of the trainer (e.g. full for the full model at 8k tokens per rank); empty = none.
  ${ACTOR_RECOMPUTE:+"+${IMPL}.recompute=${ACTOR_RECOMPUTE}"}
  # The colocated ref config selects this node; it must exist (an empty default is not a node).
  "+${IMPL}.runtime_plugins={}"
  actor_rollout_ref.actor.optim.betas='[0.9,0.95]'
  actor_rollout_ref.actor.optim.lr="${ACTOR_LR}"
  actor_rollout_ref.actor.optim.lr_warmup_steps=0
  actor_rollout_ref.actor.optim.clip_grad=1.0
  actor_rollout_ref.actor.ppo_mini_batch_size="${PPO_MINI_BATCH_SIZE}"
  actor_rollout_ref.actor.ppo_micro_batch_size_per_gpu=1
  actor_rollout_ref.actor.use_dynamic_bsz=True
  actor_rollout_ref.actor.ppo_max_token_len_per_gpu="${PPO_MAX_TOKEN_LEN_PER_GPU}"
  actor_rollout_ref.actor.use_kl_loss=False
  actor_rollout_ref.actor.kl_loss_coef=0.0
  actor_rollout_ref.actor.entropy_coeff=0
  actor_rollout_ref.actor.clip_ratio_high=0.28
  actor_rollout_ref.actor.clip_ratio_c=10.0

  # vLLM rollout: the layout (ROLLOUT_TP, DP x EP), R3 when K31_R3=1; the arm's engine knobs are in BI_ARGS.
  actor_rollout_ref.rollout.name=vllm
  actor_rollout_ref.rollout.load_format=auto
  actor_rollout_ref.rollout.tensor_model_parallel_size="${ROLLOUT_TP}"
  actor_rollout_ref.rollout.data_parallel_size="${ROLLOUT_DP}"
  actor_rollout_ref.rollout.expert_parallel_size="${ROLLOUT_EP}"
  actor_rollout_ref.rollout.agent.num_workers="${ROLLOUT_AGENT_WORKERS}"
  actor_rollout_ref.rollout.gpu_memory_utilization="${ROLLOUT_GPU_MEMORY_UTILIZATION}"
  actor_rollout_ref.rollout.n="${ROLLOUT_N}"
  actor_rollout_ref.rollout.temperature=1.0
  actor_rollout_ref.rollout.top_p=1.0
  actor_rollout_ref.rollout.top_k=-1
  actor_rollout_ref.rollout.calculate_log_probs=True
  actor_rollout_ref.rollout.log_prob_use_dynamic_bsz=True
  actor_rollout_ref.rollout.log_prob_max_token_len_per_gpu="${PPO_MAX_TOKEN_LEN_PER_GPU}"
  actor_rollout_ref.rollout.log_prob_micro_batch_size_per_gpu=1
  actor_rollout_ref.rollout.max_model_len="${ROLLOUT_MAX_MODEL_LEN}"
  actor_rollout_ref.rollout.enable_chunked_prefill=True
  actor_rollout_ref.rollout.enable_prefix_caching="${ROLLOUT_PREFIX_CACHING}"
  actor_rollout_ref.rollout.enforce_eager=False
  actor_rollout_ref.rollout.enable_rollout_routing_replay="${ROLLOUT_ROUTING_REPLAY}"
  # The adapter's layout (both arms): which modules carry LoRA, and the experts' shared LoRA.
  "+${VLLM_KW}.enable_moe_shared_loras=True"
  "+${VLLM_KW}.lora_target_modules=${LORA_TARGETS}"

  # Reward and trainer.
  reward.reward_manager.name=dapo
  reward.custom_reward_function.path="${REWARD_FN_PATH}"
  reward.custom_reward_function.name="${REWARD_FN_NAME}"
  +reward.reward_kwargs.overlong_buffer_cfg.enable=False
  +reward.reward_kwargs.max_resp_len="${MAX_RESPONSE_LENGTH}"
  trainer.logger="${TRAINER_LOGGERS}"
  trainer.project_name="${PROJECT_NAME}"
  trainer.experiment_name="${RUN_NAME}"
  trainer.n_gpus_per_node="${NGPUS_PER_NODE}"
  trainer.nnodes="${NNODES}"
  trainer.total_training_steps="${TOTAL_TRAINING_STEPS}"
  trainer.save_freq="${SAVE_FREQ}"
  trainer.test_freq="${TEST_FREQ}"
  trainer.default_local_dir="${CKPT_DIR}"
  trainer.val_before_train=False
  trainer.use_v1=False
  critic.enable=False
)
# --bi 1: the batch-invariant rollout pins its kernels: FlashMLA sparse over the fp8_ds_mla cache (the layout the
# trainer reproduces bit for bit), sparse MLA through the MQA path for every batch, CUDA graphs FULL_AND_PIECEWISE.
# --bi 0: none of these, every vLLM engine knob at vLLM's default (on SM10x: FlashInfer MLA sparse with a
# per-tensor fp8 cache, FlashInfer autotune on; with expert LoRA the MXFP4 MoE oracle picks Marlin, since
# FlashInfer's TRTLLM MoE has no SiTU kernel for the BF16 activations its expert LoRA needs).  With
# K31_BYPASS=0, token-level truncated IS on the rollout/actor log-prob ratio (verl's default threshold).
BI_ARGS=()
if [[ "${BATCH_INVARIANT}" == 1 ]]; then
  BI_ARGS=(
    "+${VLLM_KW}.compilation_config.cudagraph_mode=${CUDAGRAPH_MODE}"
    "+${VLLM_KW}.attention_config.sparse_mla_force_mqa=True"
    "+${VLLM_KW}.kv_cache_dtype=fp8_ds_mla"
    "+${VLLM_KW}.mm_encoder_tp_mode=data"
  )
else
  [[ "${K31_BYPASS}" == 1 ]] || BI_ARGS+=(algorithm.rollout_correction.rollout_is=token)
fi

RECIPE_COMMAND=(
  python3 -m verl.trainer.main_ppo
  "${HYDRA_ARGS[@]}"
  "${BI_ARGS[@]}"
  "${BYPASS_ARGS[@]}"
  "${RAY_RUNTIME_ENV[@]}"
)
COMMAND=("${RECIPE_COMMAND[@]}" "${HYDRA_OVERRIDES[@]}")

print_command() {
  local arg
  for arg in "${COMMAND[@]}"; do
    printf '%q ' "${arg}"
  done
  printf '\n'
}

# The configuration Hydra composes out of every argument, whatever override form (++key=, ~key, a parent dict)
# the arguments use, and (RECIPE_COMPOSED) out of the recipe's own arguments alone.
COMPOSED="${runtime_config_root}/composed.yaml"
RECIPE_COMPOSED="${runtime_config_root}/recipe-composed.yaml"
compose_config() {
  local out="$1"
  shift
  if ! "$@" --cfg job --resolve >"${out}" 2>"${out}.log"; then
    cat "${out}.log" >&2
    die "--bi ${BATCH_INVARIANT}, K31_BYPASS=${K31_BYPASS}: Hydra could not compose the configuration"
  fi
}

# The values $1 needs in the composed configuration: $2 is a JSON object {dotted key: value, {"one_of": [values]}
# where "<missing>" allows the key to be absent, {"equals": "other.key"}, or "as_recipe": the whole subtree exactly
# as the recipe's own arguments compose it}, $3=1 also requires one update per step.  A ray_init runtime_env variable is checked as
# the workers get it: the composed value, or the Ray job config's when the composed configuration does not set
# it (null: neither sets it).
check_composed_config() {
  python3 -I - "${COMPOSED}" "$1" "$2" "$3" "${RECIPE_COMPOSED}" <<'PY' || die "$1 needs the configuration above"
import json
import os
import re
import sys

import yaml

def load(path):
    with open(path, encoding="utf-8") as f:
        lines = f.read().splitlines()
    # the configuration starts at its first top-level key (a sitecustomize may print before it)
    start = next((i for i, line in enumerate(lines) if re.match(r"[A-Za-z_]\w*:(\s|$)", line)), len(lines))
    return yaml.safe_load("\n".join(lines[start:])) or {}


cfg, recipe = load(sys.argv[1]), load(sys.argv[5])


def get(path, node=None):
    node = cfg if node is None else node
    for key in path.split("."):
        if not isinstance(node, dict) or key not in node:
            return "<missing>"
        node = node[key]
    return node


ENV = "ray_kwargs.ray_init.runtime_env.env_vars."
job = json.loads(os.environ.get("RAY_JOB_CONFIG_JSON_ENV_VAR") or "{}")
job_env = (job.get("runtime_env") or {}).get("env_vars") or {}


def worker_env(name):
    value = get(ENV + name)
    if value == "<missing>":
        value = job_env.get(name)
    return None if value is None else str(value)


def same(got, value):
    return type(got) is type(value) and got == value


def differences(path, got, want):
    if isinstance(got, dict) and isinstance(want, dict):
        for key in sorted(set(got) | set(want), key=str):
            yield from differences(f"{path}.{key}", got.get(key, "<missing>"), want.get(key, "<missing>"))
    elif not same(got, want):
        yield f"{path}={got!r}, the recipe sets {want!r}"


label, want, one_update = sys.argv[2], json.loads(sys.argv[3]), sys.argv[4] == "1"
bad = []
for key, value in want.items():
    if key.startswith(ENV):
        name = key[len(ENV):]
        if worker_env(name) != value:
            bad.append(f"the Ray workers get {name}={worker_env(name)!r}, needs {value!r}")
    elif value == "as_recipe":
        bad.extend(differences(key, get(key), get(key, recipe)))
    elif isinstance(value, dict) and "equals" in value:
        if get(key) != get(value["equals"]):
            bad.append(f"{key}={get(key)!r} but {value['equals']}={get(value['equals'])!r}")
    elif isinstance(value, dict):
        if not any(same(get(key), allowed) for allowed in value["one_of"]):
            bad.append(f"{key}={get(key)!r}, needs one of {value['one_of']!r}")
    elif not same(get(key), value):
        bad.append(f"{key}={get(key)!r}, needs {value!r}")
mini, batch = get("actor_rollout_ref.actor.ppo_mini_batch_size"), get("data.train_batch_size")
if one_update and mini != batch:
    bad.append(f"ppo_mini_batch_size={mini!r} != train_batch_size={batch!r}: one update per step")
for item in bad:
    print(f"error: {label}: {item}", file=sys.stderr)
sys.exit(1 if bad else 0)
PY
}

printf 'MODE=%s BI=%s R3=%s PREFIX_CACHING=%s TOPOLOGY=%sx%s ACTOR_PPxEP=%sx%s ROLLOUT_TP=%s ROLLOUT_DPxEP=%sx%s LAYERS=%s\n' \
  "${MODE}" "${BATCH_INVARIANT}" "${K31_R3}" "${ROLLOUT_PREFIX_CACHING}" "${NNODES}" "${NGPUS_PER_NODE}" "${ACTOR_PP}" "${ACTOR_EP}" "${ROLLOUT_TP}" "${ROLLOUT_DP}" "${ROLLOUT_EP}" "${NUM_LAYERS}"

if [[ "${DRY_RUN:-0}" == 1 ]]; then
  print_command
  if (( ${#RAY_JOB_ENV_NAMES[@]} )); then
    printf 'RAY_JOB_CONFIG env_vars (values not shown): %s\n' "${RAY_JOB_ENV_NAMES[*]}"
  fi
  exit 0
fi

# Before anything runs: the composed configuration keeps what this launch set up.  Both arms: the Ray workers
# get this arm's execution contract.
compose_config "${COMPOSED}" "${COMMAND[@]}"
if (( ${#HYDRA_OVERRIDES[@]} )); then
  compose_config "${RECIPE_COMPOSED}" "${RECIPE_COMMAND[@]}"
else
  cp "${COMPOSED}" "${RECIPE_COMPOSED}"
fi
check_composed_config "--bi ${BATCH_INVARIANT}" "$(python3 -I "${runtime_config_root}/hydra_args.py" contract)" 0
# Both arms: the rollout runs CUDA graphs (no eager mode), returns its log-probs (token TIS at --bi 0, the
# rollout/trainer comparison and K31_BYPASS at --bi 1) and leaves cuBLAS to the arm (verl's full_determinism would
# set the BI workspace in the vLLM server).  The vLLM engine arguments (cudagraph mode and every other compilation
# setting, the KV cache dtype, the attention backend, LoRA layout, FlashInfer autotune; vllm_async_server passes
# them after the rollout's own settings), the trainer's impl_cfg (layer selector, QAT, DeepEP, runtime plugins) and
# Ray's ray_init (cluster address, code paths and environment of the workers) are exactly the recipe's own, and
# the rollout's max_model_len is the one the actor gets (DSA numerical contract).
check_composed_config "--bi ${BATCH_INVARIANT}" '{
  "actor_rollout_ref.rollout.calculate_log_probs": true,
  "actor_rollout_ref.rollout.enforce_eager": false,
  "actor_rollout_ref.rollout.full_determinism": false,
  "actor_rollout_ref.rollout.engine_kwargs.vllm": "as_recipe",
  "actor_rollout_ref.actor.engine.impl_cfg": "as_recipe",
  "ray_kwargs.ray_init": "as_recipe",
  "actor_rollout_ref.rollout.max_model_len": {"equals": "actor_rollout_ref.actor.engine.impl_cfg.rollout_max_model_len"}
}' 0
# The values themselves, besides equality with the recipe's composition.  --bi 1: the fp8_ds_mla cache, FlashMLA
# sparse and DeepSelect (or unset: vLLM's batch-invariant DSA pin picks them), no FlashInfer autotune.  --bi 0: no
# engine knob beyond the adapter layout, so every one of them is vLLM's default.
if [[ "${BATCH_INVARIANT}" == 1 ]]; then
  check_composed_config "--bi 1" '{
    "actor_rollout_ref.rollout.engine_kwargs.vllm.kv_cache_dtype": "fp8_ds_mla",
    "actor_rollout_ref.rollout.engine_kwargs.vllm.attention_config.backend": {"one_of": ["<missing>", "FLASHMLA_SPARSE"]},
    "actor_rollout_ref.rollout.engine_kwargs.vllm.kernel_config.sparse_indexer_topk_backend": {"one_of": ["<missing>", "deep_select"]},
    "actor_rollout_ref.rollout.engine_kwargs.vllm.enable_flashinfer_autotune": {"one_of": ["<missing>", false]}
  }' 0
else
  check_composed_config "--bi 0" '{
    "actor_rollout_ref.rollout.engine_kwargs.vllm.kv_cache_dtype": {"one_of": ["<missing>"]},
    "actor_rollout_ref.rollout.engine_kwargs.vllm.attention_config": {"one_of": ["<missing>"]},
    "actor_rollout_ref.rollout.engine_kwargs.vllm.kernel_config": {"one_of": ["<missing>"]},
    "actor_rollout_ref.rollout.engine_kwargs.vllm.compilation_config": {"one_of": ["<missing>"]},
    "actor_rollout_ref.rollout.engine_kwargs.vllm.enable_flashinfer_autotune": {"one_of": ["<missing>"]},
    "actor_rollout_ref.rollout.engine_kwargs.vllm.mm_encoder_tp_mode": {"one_of": ["<missing>"]}
  }' 0
fi
# Router replay as K31_R3 set it (both arms), and prefix caching as ROLLOUT_PREFIX_CACHING set it (R3 needs it).
if [[ "${K31_R3}" == 1 ]]; then
  check_composed_config "--bi ${BATCH_INVARIANT}, K31_R3=1" '{
    "actor_rollout_ref.actor.engine.router_replay_mode": "R3",
    "actor_rollout_ref.rollout.enable_rollout_routing_replay": true,
    "actor_rollout_ref.rollout.enable_prefix_caching": true
  }' 0
else
  check_composed_config "--bi ${BATCH_INVARIANT}, K31_R3=0" "{
    \"actor_rollout_ref.actor.engine.router_replay_mode\": \"disabled\",
    \"actor_rollout_ref.rollout.enable_rollout_routing_replay\": false,
    \"actor_rollout_ref.rollout.enable_prefix_caching\": ${ROLLOUT_PREFIX_CACHING,,}
  }" 0
fi
if [[ "${K31_BYPASS}" == 1 ]]; then
  check_composed_config K31_BYPASS=1 '{
    "algorithm.rollout_correction.bypass_mode": true,
    "algorithm.rollout_correction.loss_type": "ppo_clip",
    "algorithm.rollout_correction.rollout_is": null,
    "algorithm.rollout_correction.rollout_rs": null,
    "actor_rollout_ref.actor.policy_loss.loss_mode": "vanilla",
    "actor_rollout_ref.actor.ppo_epochs": 1
  }' 1
fi
# --bi 0: old_log_prob recomputed and corrected with token TIS (router replay: K31_R3=1 above; the baseline's
# rollout knobs are the recipe's engine arguments).  A Ray node started with CUBLAS_WORKSPACE_CONFIG /
# CUBLASLT_WORKSPACE_SIZE still hands them to every worker (a runtime_env cannot unset a variable): the trainer
# refuses that at init; the rollout does not check it.
if [[ "${BATCH_INVARIANT}" == 0 && "${K31_BYPASS}" == 0 ]]; then
  check_composed_config "--bi 0, K31_BYPASS=0" '{
    "algorithm.rollout_correction.bypass_mode": false,
    "algorithm.rollout_correction.rollout_is": "token"
  }' 0
fi
# Package probe: on every GPU node of the Ray cluster (RAY_ADDRESS, required above), the workers import the same
# vllm, megatron.lite and megatron.core files (and versions) as this launcher, which the preflight found to be the
# image's; megatron.lite, megatron.core and every PYTHONPATH tree (VERL_ROOT, MEGATRON_ROOT, the verl_mlite
# examples) have the same content (a digest of every file, bytecode and .git excluded) as on this launcher; and the
# image's /opt/k31/verify_k31.sh (vllm, megatron.lite, megatron.core and the image's source trees against its
# manifest) exists and passes there, run with the worker's own interpreter on the vllm the worker imports; the
# image's own files (/opt/k31: SOURCES, manifests, verify_k31.sh) and the interpreter, torch, triton, flashinfer and
# NCCL distributions (version and RECORD) are the launcher's.
# Fail closed: a missing verifier, an unreachable node or a probe error stops the launch.
[[ "${DRY_RUN:-0}" == 1 || "${COMPOSE_ONLY:-0}" == 1 ]] || python3 - "${COMPOSED}" "${NNODES}" <<'PY' || die "the workers do not import the image's vllm / megatron.lite / megatron.core, or the image verifier fails (start every Ray node from the image's environment)"
import os
import re
import sys

import yaml

WHERE = r"""
import hashlib
import importlib.metadata
import os
import subprocess
import sys


def tree_digest(top):
    # every file under top by relative path and content, every symbolic link by its target (os.walk does not
    # descend into a linked directory; links must resolve inside top), bytecode and .git excluded
    def unreadable(error):
        raise error

    digest = hashlib.sha256()
    for root, dirs, files in os.walk(top, onerror=unreadable):
        dirs[:] = sorted(d for d in dirs if d not in ("__pycache__", ".git"))
        for name in sorted(dirs + files):
            path = os.path.join(root, name)
            rel = os.path.relpath(path, top).encode() + bytes(1)
            if os.path.islink(path):
                # a link must stay inside top and out of its skipped .git / __pycache__, where this digest
                # covers the files
                target, real_top = os.path.realpath(path), os.path.realpath(top)
                if (os.path.commonpath([target, real_top]) != real_top
                        or {".git", "__pycache__"} & set(os.path.relpath(target, real_top).split(os.sep))):
                    raise ValueError(f"{path} links outside {top} (or into a skipped directory), to {target}")
                digest.update(b"L" + rel + os.readlink(path).encode())
            elif name in files:
                with open(path, "rb") as f:
                    digest.update(b"F" + rel + hashlib.sha256(f.read()).digest())
    return digest.hexdigest()


def image_files(top="/opt/k31"):
    # the image's own files next to its trees (SOURCES, the manifests, verify_k31.sh): name -> sha256
    if not os.path.isdir(top):
        return None
    out = {}
    for name in sorted(os.listdir(top)):
        path = os.path.join(top, name)
        if os.path.isfile(path):
            with open(path, "rb") as f:
                out[name] = hashlib.sha256(f.read()).hexdigest()
    return out


def packages():
    # the interpreter, and the installed torch / triton / flashinfer / NCCL distributions: version and RECORD digest
    out = {"python": [os.path.realpath(sys.executable), sys.version]}
    for dist in importlib.metadata.distributions():
        name = (dist.metadata["Name"] or "").lower()
        if name in ("torch", "triton") or name.startswith(("flashinfer", "nvidia-nccl")):
            out[name] = [dist.version, hashlib.sha256((dist.read_text("RECORD") or "").encode()).hexdigest()]
    return dict(sorted(out.items()))


def where():
    import megatron.lite
    import vllm

    lite = importlib.metadata.version("nemotron-megatron-lite")
    # verify_k31.sh checks the packages of this interpreter (K31_PYTHON, this process's environment) and names the
    # vllm directory it checked, which must be the one this process imports
    verify, rc = "/opt/k31/verify_k31.sh", None
    if os.path.exists(verify):
        out = subprocess.run(["bash", verify], capture_output=True, text=True,
                             env={**os.environ, "K31_PYTHON": sys.executable})
        # its result line (stdout; stderr carries whatever the interpreter warns about), else the last error line
        ok = [line for line in out.stdout.splitlines() if line.startswith("VERIFY_K31_OK ")][-1:]
        last = ok or (out.stdout + out.stderr).strip().splitlines()[-1:]
        checked = ok[0].rpartition(" vllm=")[2] if ok and " vllm=" in ok[0] else None
        rc = [out.returncode, last, checked == os.path.dirname(os.path.realpath(vllm.__file__))]
    try:
        import megatron.core as mcore

        top = os.path.dirname(os.path.realpath(mcore.__file__))
        core = [top, tree_digest(top)]
    except ImportError:
        core = None
    lite_top = os.path.dirname(os.path.realpath(megatron.lite.__file__))
    pythonpath = [[entry, tree_digest(entry) if os.path.isdir(entry) else None]
                  for entry in os.environ.get("PYTHONPATH", "").split(os.pathsep) if entry]
    return {"vllm": [os.path.realpath(vllm.__file__), vllm.__version__],
            "megatron.lite": [os.path.realpath(megatron.lite.__file__), lite, tree_digest(lite_top)],
            "megatron.core": core,
            "PYTHONPATH": pythonpath,
            "image": image_files(),
            "packages": packages(),
            "verify_k31.sh": rc}


def mismatches(mine, results, nnodes):
    # what stops the launch, given this launcher's where() and each probed GPU node's (name, where()) result
    bad = [f"the Ray cluster has {len(results)} GPU nodes, this launch runs on {nnodes}"] if len(results) != nnodes else []
    bad += [f"node {node}: {name} is {got[name]}, this launcher's is {mine[name]}"
            for node, got in results for name in mine if got[name] != mine[name]]
    bad += [f"node {node}: verify_k31.sh {'missing' if got['verify_k31.sh'] is None else got['verify_k31.sh']}"
            f" (expected exit 0 on the vllm this worker imports, {got['vllm'][0]})"
            for node, got in results
            if got["verify_k31.sh"] is None or got["verify_k31.sh"][0] != 0 or not got["verify_k31.sh"][2]]
    # the image installs megatron.core (pipeline-parallel actors need it): failing to import it anywhere stops the launch
    bad += [f"{who}: megatron.core does not import"
            for who, got in [("this launcher", mine), *(("node " + node, got) for node, got in results)]
            if got["megatron.core"] is None]
    return bad
"""
ns = {}
exec(WHERE, ns)
where = ns["where"]

with open(sys.argv[1], encoding="utf-8") as f:
    lines = f.read().splitlines()
start = next((i for i, line in enumerate(lines) if re.match(r"[A-Za-z_]\w*:(\s|$)", line)), len(lines))
runtime_env = yaml.safe_load("\n".join(lines[start:]))["ray_kwargs"]["ray_init"]["runtime_env"]
mine = where()
import ray
from ray.util.scheduling_strategies import NodeAffinitySchedulingStrategy

ray.init(address=os.environ["RAY_ADDRESS"], runtime_env={k: v for k, v in runtime_env.items() if v is not None},
         log_to_driver=False)
# one listing gives the probe targets and the names their results are reported under
gpu_nodes = [node for node in ray.nodes() if node["Alive"] and node["Resources"].get("GPU", 0) > 0]
nodes = [node["NodeManagerAddress"] for node in gpu_nodes]
probe = ray.remote(num_cpus=0)(where)
theirs = ray.get([
    probe.options(scheduling_strategy=NodeAffinitySchedulingStrategy(node["NodeID"], soft=False)).remote()
    for node in gpu_nodes
], timeout=900)
ray.shutdown()
bad = ns["mismatches"](mine, list(zip(nodes, theirs)), int(sys.argv[2]))
for item in bad:
    print(f"error: {item}", file=sys.stderr)
if not bad:
    print(f"WORKER_PACKAGES nodes={len(nodes)} vllm={mine['vllm'][1]} "
          f"megatron.lite={mine['megatron.lite'][1]}/{mine['megatron.lite'][2][:12]} "
          f"megatron.core={mine['megatron.core'][1][:12]} "
          f"PYTHONPATH={','.join(str(d)[:12] for _, d in mine['PYTHONPATH'])} verify_k31.sh=0")
sys.exit(1 if bad else 0)
PY

if [[ "${COMPOSE_ONLY:-0}" == 1 ]]; then
  cat "${COMPOSED}"
  exit 0
fi

set +e
"${COMMAND[@]}" 2>&1 | tee "${LOG_FILE}"
run_rc="${PIPESTATUS[0]}"
set -e
exit "${run_rc}"
